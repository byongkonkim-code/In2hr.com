# ============================================================================
# IN2U HR Automation Suite - External API Integration Environment Variables
# ============================================================================
# Note: If keys are omitted, the platform automatically falls back to built-in
# AI & RPA simulation engines so all 5 modules work out-of-the-box!

# 1. OpenAI API (Module 1: Resume Parsing & Scoring / Module 2: Multilingual Pre-screening Chatbot)
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# 2. Twilio / Kakao AlimTalk (Module 2 & 3: SMS/Kakao Pre-screening Link & Interview Reminder)
TWILIO_ACCOUNT_SID=AC_your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15550001234
KAKAO_BIZ_SENDER_KEY=your_kakao_sender_key

# 3. Calendly & Zoom API (Module 3: Interview Slot Sync & Auto-Meeting Creation)
CALENDLY_API_TOKEN=your_calendly_personal_access_token
CALENDLY_ORGANIZATION_URI=https://api.calendly.com/organizations/YOUR_ORG
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# 4. DocuSign & Checkr API (Module 4: E-Signature Onboarding Package & Background Check)
DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
CHECKR_API_KEY=your_checkr_secret_key

# 5. QuickBooks Online / Xero API (Module 5: Timesheet-Driven Payroll & Auto-Invoicing)
QUICKBOOKS_CLIENT_ID=your_qbo_client_id
QUICKBOOKS_CLIENT_SECRET=your_qbo_client_secret
QUICKBOOKS_REALM_ID=your_qbo_company_realm_id
QUICKBOOKS_ENV=sandbox
